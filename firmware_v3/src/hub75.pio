.program hub75_data_v3
.side_set 1

; SM0: High-efficiency data shifter
; 5 pixels (30 bits) packed into each 32-bit FIFO word.
; autopull is configured to 30 bits -- after 5x out pins,6
; the next word is fetched automatically.
; side-set bit 0 = CLK

.wrap_target
    out pins, 6 side 0 [3]     ; pixel 0, CLK=LOW
    nop side 1 [3]             ; CLK=HIGH
    out pins, 6 side 0 [3]     ; pixel 1
    nop side 1 [3]
    out pins, 6 side 0 [3]     ; pixel 2
    nop side 1 [3]
    out pins, 6 side 0 [3]     ; pixel 3
    nop side 1 [3]
    out pins, 6 side 0 [3]     ; pixel 4
    nop side 1                 ; CLK=HIGH for pixel 4
.wrap


.program hub75_latoe_v3
.side_set 1

; SM1: LAT pulse + OE window generator
; Receives OE duration (in PIO cycles) from FIFO.
; side-set bit 0 = LAT
; set pins = OE (single pin, configured separately)

.wrap_target
    pull block side 0
    mov x, osr side 0
    nop side 1 [2]             ; LAT=HIGH (latch pulse)
    nop side 0                 ; LAT=LOW
    set pins, 0 side 0         ; OE=LOW (display ON)

oe_wait:
    jmp x-- oe_wait side 0     ; wait X cycles

    set pins, 1 side 1         ; OE=HIGH (display OFF)
    irq set 0 side 0           ; notify Core1 via IRQ0
.wrap


.program hub75_addr_v3

; SM2: Row address output
; Core1 writes row number to X via sm_exec(),
; then this SM drives ADDR_A..D pins.

.wrap_target
    mov pins, x
.wrap


.program hub75_seq_v3

; SM3: Sequencer / future expansion
; Currently reserved for frame-boundary or chaining use.

.wrap_target
    pull block
    mov y, osr
.wrap
